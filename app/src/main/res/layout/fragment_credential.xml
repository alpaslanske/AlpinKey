<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark"
    tools:context=".ui.fragments.CredentialFragment">

    <!-- Top Action Card / Header -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/darkGrey"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/key_icon"
                    app:tint="@color/colorWhite" />

                <TextView
                    android:id="@+id/text_header_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/title_credential"
                    android:textColor="@color/colorWhite"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- TableRow baseline for compatibility if referenced -->
            <TableRow
                android:id="@+id/credential_borderline"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#3A3F50" />

            <!-- Horizontal Action Buttons -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/button_hardwareBacked"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Hardware Backed"
                        app:backgroundTint="@color/ruby"
                        app:fabCustomSize="44dp"
                        app:maxImageSize="22dp"
                        app:srcCompat="@drawable/ic_microchip"
                        app:tint="@color/colorWhite" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/button_backup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Backup"
                        app:backgroundTint="@color/ruby"
                        app:fabCustomSize="44dp"
                        app:maxImageSize="22dp"
                        app:srcCompat="@drawable/ic_backup"
                        app:tint="@color/colorWhite" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/button_restore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Restore"
                        app:backgroundTint="@color/ruby"
                        app:fabCustomSize="44dp"
                        app:maxImageSize="22dp"
                        app:srcCompat="@drawable/ic_restore"
                        app:tint="@color/colorWhite" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/button_resetPin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Reset PIN"
                        app:backgroundTint="@color/ruby"
                        app:fabCustomSize="44dp"
                        app:maxImageSize="22dp"
                        app:srcCompat="@drawable/ic_pin_pad"
                        app:tint="@color/colorWhite" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/button_deleteall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Delete All"
                        app:backgroundTint="@color/ruby"
                        app:fabCustomSize="44dp"
                        app:maxImageSize="22dp"
                        app:srcCompat="@drawable/trash_icon"
                        app:tint="@color/colorWhite" />

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Empty State View -->
    <LinearLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_header">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_logo_wiokey_small"
            app:tint="@color/lightGrey" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/faq_9_empty"
            android:textColor="@color/colorWhite"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Credentials RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listview_credentials"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_header" />

</androidx.constraintlayout.widget.ConstraintLayout>